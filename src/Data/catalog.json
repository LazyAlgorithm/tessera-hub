  "dependencies": [
    {
      "id": "beef",
      "name": "Beef compiler",
      "summary": "Compiles Tessera projects' scripts.",
      "size": "about 100 MB",
      "found": [
        {
          "env": "BEEFBUILD"
        },
        {
          "program": "BeefBuild"
        },
        {
          "file": {
            "windows": "{tools}/beef/bin/BeefBuild.exe",
            "linux": "{tools}/beef/IDE/dist/BeefBuild.sh"
          }
        },
        {
          "file": {
            "windows": "C:/Program Files/BeefLang/bin/BeefBuild.exe"
          }
        }
      ],
      "install": {
        "windows": [
          {
            "download": "https://github.com/LazyAlgorithm/Tessera/releases/download/toolchain-2/beef-windows-x64.zip",
            "unpack": "{tools}"
          }
        ],
        "linux": [
          {
            "download": "https://github.com/LazyAlgorithm/Tessera/releases/download/toolchain-2/beef-linux-x64.tar.gz",
            "unpack": "{tools}"
          }
        ]
      }
    },
    {
      "id": "python",
      "name": "Python 3.11 or later",
      "summary": "Runs Tessera's build scripts. A copy only Tessera uses is installed.",
      "size": "about 50 MB",
      "found": [
        {
          "command": {
            "windows": "python -c \"import sys; sys.exit(0 if sys.version_info >= (3, 11) else 1)\"",
            "linux": "python3 -c \"import sys; sys.exit(0 if sys.version_info >= (3, 11) else 1)\""
          }
        },
        {
          "file": {
            "windows": "{tools}/python/python.exe",
            "linux": "{tools}/python/bin/python3"
          }
        }
      ],
      "install": {
        "windows": [
          {
            "download": "https://github.com/LazyAlgorithm/Tessera/releases/download/toolchain-2/python-windows-x64.zip",
            "unpack": "{tools}"
          }
        ],
        "linux": [
          {
            "download": "https://github.com/LazyAlgorithm/Tessera/releases/download/toolchain-2/python-linux-x64.tar.gz",
            "unpack": "{tools}"
          }
        ]
      }
    },
    {
      "id": "vc-runtime",
      "name": "Microsoft Visual C++ x64 runtime",
      "summary": "Installs the shared runtime into Windows so other applications can use it. Administrator approval is required.",
      "size": "About 25 MB",
      "platforms": [
        "windows"
      ],
      "licence": {
        "name": "Microsoft Visual C++ Runtime licence",
        "url": "https://learn.microsoft.com/en-us/cpp/windows/redistributing-visual-cpp-files"
      },
      "found": [
        {
          "command": {
            "windows": "powershell -NoProfile -NonInteractive -Command \"$paths = @('HKLM:\\SOFTWARE\\Microsoft\\VisualStudio\\14.0\\VC\\Runtimes\\x64', 'HKLM:\\SOFTWARE\\WOW6432Node\\Microsoft\\VisualStudio\\14.0\\VC\\Runtimes\\x64'); foreach ($p in $paths) { $r = Get-ItemProperty -LiteralPath $p -ErrorAction SilentlyContinue; if ($r.Installed -eq 1) { exit 0 } }; exit 1\""
          }
        },
        {
          "all": [
            {
              "file": {
                "windows": "{windows}/System32/vcruntime140.dll"
              }
            },
            {
              "file": {
                "windows": "{windows}/System32/vcruntime140_1.dll"
              }
            },
            {
              "file": {
                "windows": "{windows}/System32/msvcp140.dll"
              }
            }
          ]
        }
      ],
      "install": {
        "windows": [
          {
            "download": "https://aka.ms/vc14/vc_redist.x64.exe"
          },
          {
            "runAsAdmin": "\"{hub}/downloads/vc_redist.x64.exe\" /install /quiet /norestart /log \"{hub}/vc-runtime-install.log\""
          },
          {
            "delete": "{hub}/downloads/vc_redist.x64.exe"
          }
        ]
      }
    },
    {
      "id": "microsoft-libraries",
      "name": "Microsoft C++ Build Tools and Windows SDK",
      "summary": "Registered Windows installations, usable by Tessera and other apps. Windows asks for administrator approval; setup runs quietly.",
      "size": "Several GB; existing installations are reused",
      "platforms": [
        "windows"
      ],
      "licence": {
        "name": "Microsoft Visual Studio Build Tools licence",
        "url": "https://go.microsoft.com/fwlink/?LinkId=2086102"
      },
      "found": [
        {
          "all": [
            {
              "file": {
                "windows": "{tools}/beef/bin/BeefBuild.exe"
              }
            },
            {
              "beefLibraries": {
                "windows": "{tools}/beef/bin/BeefSettings.toml"
              }
            }
          ]
        }
      ],
      "install": {
        "windows": [
          {
            "download": "https://aka.ms/vs/17/release/vs_BuildTools.exe"
          },
          {
            "write": "{hub}/installer-logs/README.txt",
            "text": "Microsoft installer logs are stored in this folder.\n"
          },
          {
            "runAsAdmin": "set \"TEMP={hub}/installer-logs\" && set \"TMP={hub}/installer-logs\" && \"{hub}/downloads/vs_BuildTools.exe\" --quiet --wait --norestart --nocache --add Microsoft.VisualStudio.Workload.VCTools --includeRecommended"
          },
          {
            "configureMicrosoft": "{tools}/beef/bin/BeefSettings.toml"
          },
          {
            "delete": "{hub}/downloads/vs_BuildTools.exe"
          }
        ]
      },
      "alsoInstall": [
        "beef",
        "vc-runtime"
      ]
    },
    {
      "id": "linux-build-tools",
      "name": "C compiler, X11 and OpenGL development files",
      "summary": "What Linux programs are linked with. Installed by your system's package manager, which asks for your password.",
      "platforms": [
        "linux"
      ],
      "found": [
        {
          "all": [
            {
              "program": "cc"
            },
            {
              "libraries": [
                "libGL.so",
                "libX11.so"
              ]
            }
          ]
        }
      ],
      "install": {
        "linux": [
          {
            "packages": {
              "apt-get": "build-essential libgl-dev libx11-dev",
              "dnf": "gcc gcc-c++ mesa-libGL-devel libX11-devel",
              "pacman": "base-devel libglvnd libx11",
              "zypper": "gcc gcc-c++ Mesa-libGL-devel libX11-devel"
            }
          }
        ]
      }
    }
  ]
}
